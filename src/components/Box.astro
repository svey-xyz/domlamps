---
/**
 * A shadow-casting / light-receiving element with height.
 * Renders any tag; everything inside stays normal DOM.
 */
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> & {
  /** Height above the floor, CSS px. Animatable via --z. */
  z?: number;
  material?: 'solid' | 'glass' | 'paper' | 'metal' | 'emissive';
  /** Shadow / transmission tint (glass, paper) or glow colour (emissive). */
  tint?: string;
  /** Fraction of light blocked, 0–1. Defaults per material. */
  opacity?: number;
  /** Specular strength of the top surface, 0–1. */
  shine?: number;
};

const { as: Tag = 'div', z, material = 'solid', tint, opacity, shine, style, ...rest } = Astro.props;
// Only emit what was passed, so CSS rules (and transitions) can own the rest.
const vars = [z !== undefined && `--z:${z}`, tint && `--tint:${tint}`, style].filter(Boolean).join(';') || undefined;
---

<Tag data-box data-material={material} data-opacity={opacity} data-shine={shine} style={vars} {...rest}><slot /></Tag>
