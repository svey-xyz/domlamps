---
/**
 * A light source. Position it like any absolutely positioned element.
 * Inside a <Box>, --lz is relative to that box's --z (negative = inside it, a lantern).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'span'>, 'dir'> {
  type?: 'point' | 'spot' | 'sun';
  /** Height (relative to the owning box, if any). */
  z?: number;
  intensity?: number;
  /** Falloff radius, CSS px. */
  radius?: number;
  color?: string;
  /** Spot/sun direction in degrees (0 = right, 90 = down the page). */
  dir?: number;
  /** Spot cone angle, degrees. */
  cone?: number;
  /** Sun elevation, degrees. */
  elevation?: number;
  /** Shadow hardness: higher = crisper penumbra. */
  soft?: number;
  /** Flicker amplitude 0–1. */
  flicker?: number;
  /** Glow size multiplier; 0 disables the bloom. */
  bloom?: number;
}

const { type = 'point', z, intensity, radius, color, dir, cone, elevation, soft, flicker, bloom, class: cls, style, ...rest } = Astro.props;
const vars = [
  // Only emit what was passed; @property initial values cover the rest and CSS can transition them.
  z !== undefined && `--lz:${z}`,
  intensity !== undefined && `--intensity:${intensity}`,
  radius !== undefined && `--radius:${radius}`,
  color !== undefined && `--light-color:${color}`,
  dir !== undefined && `--dir:${dir}deg`,
  cone !== undefined && `--cone:${cone}deg`,
  elevation !== undefined && `--elevation:${elevation}deg`,
  style,
].filter(Boolean).join(';') || undefined;
---

<span data-light={type} data-soft={soft} data-flicker={flicker} data-bloom={bloom} aria-hidden="true" class:list={['lumen-light', cls]} style={vars} {...rest}><slot /></span>
