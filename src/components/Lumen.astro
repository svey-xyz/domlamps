---
/**
 * Mounts the lighting engine. Place once per page (e.g. in the layout).
 * Everything else is declared in markup with <Box> / <Light> or raw data attributes.
 */
import '../lib/lumen/lumen.css';

interface Props {
  /** Light-map resolution, canvas px per CSS px. */
  scale?: number;
  /** Ambient light colour (the "darkness"). Any CSS colour. */
  ambient?: string;
}
const { scale = 0.5, ambient = '#1d1c24' } = Astro.props;
---

<lumen-scene data-scale={scale} style={`--lumen-ambient:${ambient}`}></lumen-scene>

<style is:global>
  lumen-scene { display: contents; }
</style>

<script>
  import { Lumen } from '../lib/lumen/engine';

  class LumenScene extends HTMLElement {
    engine?: Lumen;
    connectedCallback() {
      // Ambient lives on :root so every light-map read sees it.
      document.documentElement.style.setProperty('--lumen-ambient', this.style.getPropertyValue('--lumen-ambient'));
      this.engine = new Lumen({ scale: Number(this.dataset.scale) || 0.5 });
      if (this.engine.start()) (window as any).lumen = this.engine;
    }
    disconnectedCallback() {
      this.engine?.destroy();
    }
  }
  customElements.define('lumen-scene', LumenScene);
</script>
