---
/**
 * An article that starts mostly in darkness. The button is an amber glass box
 * with a lantern inside; opening it raises the box (--z 10 → 72) and lights
 * the lantern, which spills light across the text.
 */
import Box from './Box.astro';
import Light from './Light.astro';

interface Props { title: string; eyebrow?: string; id?: string }
const { title, eyebrow, id = 'read-more' } = Astro.props;
---

<Box as="article" z={6} class="rm" id={id} aria-labelledby={`${id}-title`}>
  <Light class="candle" z={26} radius={320} intensity={1.2} color="#ffb163" flicker={0.28} size={4} style="left:25%;top:40px" />
  <Light class="candle" z={26} radius={320} intensity={1.2} color="#ffb163" flicker={0.28} size={4} style="left:75%;top:40px" />

  <header class="rm-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={`${id}-title`}>{title}</h2>
  </header>

  <div class="rm-body"><slot /></div>

  <Box as="button" type="button" material="glass" tint="#ffae3d" opacity={0.3} class="rm-btn" aria-expanded="false" aria-controls={id}>
    <Light class="lantern" z={-12} radius={820} color="#ffc47e" size={16} />
    <span class="rm-label">Light the lantern</span>
  </Box>
</Box>

<style>
  .rm {
    position: relative;
    display: grid;
    gap: 28px;
    width: min(700px, 100%);
    margin-inline: auto;
    padding: 64px clamp(20px, 6vw, 64px) 120px;
    background: var(--paper);
    border: 1px solid rgb(0 0 0 / 0.14);
    border-radius: 4px;
  }
  .rm-head { display: grid; gap: 12px; justify-items: center; text-align: center; padding-inline: 32px; }
  .rm-body { display: grid; gap: 1.1em; }
  .rm-body :global(p) { max-width: 62ch; }

  .rm-btn {
    --z: 10;
    position: absolute;
    left: 50%;
    bottom: 40px;
    translate: -50% 0;
    display: grid;
    place-items: center;
    padding: 13px 26px;
    font: 600 0.9375rem/1 var(--body);
    color: #3a2204;
    background: color-mix(in oklab, var(--amber) 45%, #fff6e8);
    border: 1px solid #b8741c;
    border-radius: 999px;
    cursor: pointer;
    transition:
      --z 0.75s cubic-bezier(0.3, 1.45, 0.5, 1),
      translate 0.75s cubic-bezier(0.3, 1.45, 0.5, 1),
      scale 0.75s cubic-bezier(0.3, 1.45, 0.5, 1);
  }
  .rm-btn:hover { scale: 1.03; }
  .rm-btn[aria-expanded='true'] {
    --z: 72;
    translate: -50% -22px;
    scale: 1.14;
  }

  /* The lantern sits inside the glass, below its top: it lights the page around the box, not the box's own top. */
  .rm-btn :global(.lantern) {
    --intensity: 0;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    transition: --intensity 0.9s ease-out 0.18s;
  }
  .rm-btn[aria-expanded='true'] :global(.lantern) { --intensity: 2.3; }

  .rm-label { position: relative; z-index: 1; }
  :global(.candle) { width: 7px; height: 7px; }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.rm-btn')) {
    const label = btn.querySelector('.rm-label')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Snuff the lantern' : 'Light the lantern';
    });
  }
</script>
