{
  "name": "domlamps-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w domlamps && npm run build -w site",
    "build:lib": "npm run build -w domlamps",
    "test": "npm test -w domlamps",
    "test:browser": "npm run test:browser -w domlamps",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build && npm run lint:pkg -w domlamps"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  },
  "engines": {
    "node": ">=22.14"
  }
}
